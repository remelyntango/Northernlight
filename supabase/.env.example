# Secrets referenced by supabase/config.toml via env(...) substitution.
#
#   cp supabase/.env.example supabase/.env    # then fill in
#   npx supabase config push                  # applies to the linked project
#
# supabase/.env is gitignored. Nothing here should ever be committed, and none
# of it belongs in NEXT_PUBLIC_ variables — these are server-side only.

# Base URL of the site. Used to build the links inside confirmation emails and
# as the OAuth redirect allow-list, so getting this wrong sends new members to
# a dead link.
#   local dev  : http://localhost:3000
#   production : https://your-domain.example
SITE_URL=http://localhost:3000

# Resend (https://resend.com) — free tier is 3,000 emails/month, 100/day.
# Create at Dashboard → API Keys. Starts with "re_".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The From: address on confirmation emails. The domain part must be a domain
# you have verified in Resend, otherwise sending fails.
MAIL_FROM=no-reply@your-domain.example

# Google OAuth (https://console.cloud.google.com → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
