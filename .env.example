# Copy to .env.local and fill in from your Supabase project:
#   Dashboard -> Project Settings -> API
#
# Both values are safe to expose to the browser. The anon key grants no
# privileges on its own — every request it makes is filtered by Row Level
# Security. Never put the service_role key in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used for canonical URLs, sitemap.xml and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" only once Google OAuth is configured in Supabase. Controls
# whether the "Continue with Google" button is offered at all.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
